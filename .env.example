# 1. MongoDB Database Connection (VPS Public IP)
# Both user "chithila" and "mongo" are provisioned as root on the database
DATABASE_URL="mongodb://chithila:chithila123@187.77.128.167:27017/sera?authSource=admin&directConnection=true"

# 2. PayHere Payment Gateway (Your Merchant ID: 248247)
PAYHERE_MERCHANT_ID="248247"
PAYHERE_MERCHANT_SECRET="your_payhere_merchant_secret_here"
# Use 'live' for real transactions or 'sandbox' for test mode
PAYHERE_MODE="live"

# 3. Google OAuth 2.0 Sign-In
# Create credentials in Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI: https://card.seranex.lk/api/auth/google/callback
# (Also add http://localhost:3000/api/auth/google/callback for local testing)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# 4. Resend Email Delivery
# Create your key at https://resend.com/api-keys
RESEND_API_KEY="re_your_api_key_here"
RESEND_FROM_EMAIL="GoSera <info@seranex.lk>"

# 5. Super Admin Portal Credentials
